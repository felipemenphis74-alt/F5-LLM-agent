# Copie para .env (NÃO versionar em git) e preencha.
# Nomes devem bater com o que cada device referencia em inventory.yaml -> auth_env

F5_PROD01_USER=readonly_monitor
F5_PROD01_PASSWORD=changeme

F5_PROD02_USER=readonly_monitor
F5_PROD02_PASSWORD=changeme

# Opcional: caminho (dentro do container) do JSON de service account do Google,
# necessário apenas se você usar a ferramenta de baseline via Google Sheets.
GOOGLE_SHEETS_CREDENTIALS_PATH=/app/google-creds.json

# Opcional: sobrescreve limites padrão do inventory.yaml
# F5_MCP_TCPDUMP_MAX_COUNT=500
# F5_MCP_TCPDUMP_MAX_DURATION_SEC=60
# F5_MCP_COMMAND_TIMEOUT_SEC=20
